---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Kalid Djele" description="About Jeanine White Lorem Ipsum">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="A propos"
				tagline="Si-dessous mes parcours."
			>
				<img
					width="1553"
					height="873"
					src="/assets/ima.jpg"
					alt="Jeanine White at work with a colleague"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						
					</p>
					<p>
						Développeur web et formateur passionné, je conçois des solutions numériques robustes tout en transmettant mon savoir-faire. 
						Fort d'une expérience en travail d'équipe et à distance, 
						j'allie maîtrise technique et compétences relationnelles pour mener à bien des projets informatiques orientés gestion et performance.<br>
						Mon approche repose sur une communication claire, un esprit d'entraide et une rigueur méthodologique, indispensables pour réussir dans des environnements collaboratifs.					
					</p>
					<p>
						
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Profil & Qualifications</h2>
				<div class="content">
					<p>Formation Supérieure (BAC+3) </br>
						Solide socle académique en informatique / technologies numériques.
						Développeur Mobile (Niveau Intermédiaire) : Certifié D-click — Maîtrise de la conception et du déploiement d'applications mobiles performantes.
						Technicien Systèmes & Énergies : Expertise de terrain en installation et configuration de :

						Signaux et équipements satellitaires

						Systèmes de vidéosurveillance (CCTV / Sécurité)

						Solutions d'énergies renouvelables (Installations solaires)
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p>Curieux, Organiser, Dynamique, autonome, traivaille d'equipe</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
